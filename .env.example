# ─────────────────────────────────────────────────────────────────
# AgentSystem PoC —— 环境变量模板
#
# 用法：cp .env.example .env 后填入真实值。
# 宪法第七条：机密只走环境变量，.env 不进 git（已在 .gitignore 中）。
# 本文件只列变量名与格式，不含任何真实凭据。
# ─────────────────────────────────────────────────────────────────

# ── 模型档位（config/models.yaml 以 ${VAR} 引用，不写明文）──────────
# M0 本机 Ollama 无需 key
# M1/M2 AutoDL 自建（vLLM），经 SSH 隧道访问，暂未启用
AUTODL_SSH_HOST=
AUTODL_SSH_PORT=
# M3 AutoDL.Art 托管 API
AUTODL_ART_API_KEY=
# M4 DeepSeek 官方 API
DEEPSEEK_API_KEY=

# ── Dify ────────────────────────────────────────────────────────
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_DATASET_API_KEY=

# ── PostgreSQL ──────────────────────────────────────────────────
# 三个角色对应三种用途（P1 详细设计 §2.5 / WBS P1.3.5）：
#   app_migrator —— agentsystem 库属主，仅 Alembic 使用，有 CREATE
#   app_rw       —— 运行时账号，对 audit_log 仅 INSERT + SELECT
#   app_ro       —— 对 dify 库只读（宪法第三条）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=agentsystem
PG_MIGRATOR_USER=app_migrator
PG_MIGRATOR_PASSWORD=
PG_APP_USER=app_rw
PG_APP_PASSWORD=
PG_RO_USER=app_ro
PG_RO_PASSWORD=

# ── 身份（P1 详细设计 §2.5）────────────────────────────────────────
# PoC 用静态 Bearer 映射用户，config/users.yaml 只存 SHA-256。
# 此处放明文 token 供本地调试；生产形态应由外部身份系统签发。
DEV_TOKEN_YR_SALES=
DEV_TOKEN_QC=
